PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/cosmichorizon
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Email verification (optional in development).
# If SMTP_* is empty, the verification link is printed in the server console.
# Example: Mailtrap / Gmail app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CosmicHorizon <no-reply@cosmichorizon.space>

# External Space APIs
NASA_API_KEY=DEMO_KEY
